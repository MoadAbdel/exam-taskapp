# Copier en .env (jamais versionne). En production, les valeurs sont dans Vercel (Environment Variables).
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/taskapp
# Generer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Origines autorisees en CORS, separees par des virgules (vide = meme origine seulement)
CORS_ORIGINS=
LOG_LEVEL=http
LOG_TO_FILE=false
